{
  "name": "GPUDay.Common",
  "displayName": "GPU Day - Common",
  "description": "Common recipe steps for Media Theme and regular theme setup.",
  "author": "Lombiq",
  "website": "https://www.gpuday.com",
  "version": "1.0",
  "issetuprecipe": false,
  "categories": [ "gpuday" ],
  "tags": [ "HideFromSetupScreen" ],

  "steps": [
    {
      "name": "feature",
      "disable": [],
      "enable": [
        // Orchard Core
        "OrchardCore.Admin",
        "OrchardCore.AdminDashboard",
        "OrchardCore.AdminTemplates",
        "OrchardCore.Alias",
        "OrchardCore.Autoroute",
        "OrchardCore.ContentFields",
        "OrchardCore.ContentFields.Indexing.SQL",
        "OrchardCore.ContentTypes",
        "OrchardCore.Contents",
        "OrchardCore.Contents.Deployment.Download",
        "OrchardCore.Deployment",
        "OrchardCore.Deployment.Remote",
        "OrchardCore.Diagnostics",
        "OrchardCore.DynamicCache",
        "OrchardCore.Flows",
        "OrchardCore.HealthChecks",
        "OrchardCore.HomeRoute",
        "OrchardCore.Html",
        "OrchardCore.Https",
        "OrchardCore.Layers",
        "OrchardCore.Liquid",
        "OrchardCore.Lists",
        "OrchardCore.Media",
        "OrchardCore.Media.Cache",
        "OrchardCore.Menu",
        "OrchardCore.Navigation",
        "OrchardCore.Placements",
        "OrchardCore.Placements.FileStorage",
        "OrchardCore.Queries",
        "OrchardCore.Queries.Sql",
        "OrchardCore.ReCaptcha",
        "OrchardCore.ReCaptcha.Users",
        "OrchardCore.Resources",
        "OrchardCore.ReverseProxy",
        "OrchardCore.Roles",
        "OrchardCore.Rules",
        "OrchardCore.Seo",
        "OrchardCore.Taxonomies",
        "OrchardCore.Templates",
        "OrchardCore.Themes",
        "OrchardCore.Title",
        "OrchardCore.Users",
        "OrchardCore.Widgets",
        "OrchardCore.Workflows",
        "OrchardCore.Workflows.Http",

        // Lombiq
        "Lombiq.HelpfulExtensions.ContentTypes",
        "Lombiq.HelpfulExtensions.Widgets",
        "Lombiq.Privacy",
        "Lombiq.Privacy.ConsentBanner",
        "Lombiq.Privacy.FormConsent",

        // Themes
        "TheAdmin",
        "GPUDay.Theme"
      ]
    },
    {
      "name": "themes",
      "admin": "TheAdmin"
    },
    {
      "name": "Roles",
      "Roles": [
        {
          "Name": "Authenticated",
          "Description": "Authenticated role",
          "Permissions": [
            "ViewContent"
          ]
        },
        {
          "Name": "Anonymous",
          "Description": "Anonymous role",
          "Permissions": [
            "ViewContent"
          ]
        }
      ]
    },
    {
      "name": "recipes",
      "Values": [
        {
          "executionid": "DotNest.Core.SDK.Web",
          "name": "GPUDay.Export"
        },
        {
          "executionid": "DotNest.Core.SDK.Web",
          "name": "GPUDay.MediaTheme"
        }
      ]
    }
  ]
}

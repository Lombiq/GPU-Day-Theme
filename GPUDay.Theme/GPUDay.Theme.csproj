<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <DefaultItemExcludes>$(DefaultItemExcludes);.git*;node_modules\**;Deployment\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Theme.Targets" Version="3.0.0-preview-18979" />
    <PackageReference Include="OrchardCore.ContentManagement" Version="3.0.0-preview-18979" />
    <PackageReference Include="OrchardCore.DisplayManagement" Version="3.0.0-preview-18979" />
    <PackageReference Include="OrchardCore.ResourceManagement" Version="3.0.0-preview-18979" />
    <PackageReference Include="OrchardCore.Taxonomies" Version="3.0.0-preview-18979" />
    <PackageReference Include="OrchardCore.Media" Version="3.0.0-preview-18979" />
  </ItemGroup>

  <PropertyGroup>
    <LombiqHelpfulExtensionsPath>../../../../../../Modules/Lombiq.HelpfulExtensions/Lombiq.HelpfulExtensions/Lombiq.HelpfulExtensions.csproj</LombiqHelpfulExtensionsPath>
    <LombiqNodeJsExtensionsPath>../../../../../../Utilities/Lombiq.NodeJs.Extensions/Lombiq.NodeJs.Extensions/Lombiq.NodeJs.Extensions.csproj</LombiqNodeJsExtensionsPath>
    <LombiqHostingMediaThemePath>../../../../../Lombiq.Hosting.MediaTheme/Lombiq.Hosting.MediaTheme/Lombiq.Hosting.MediaTheme.csproj</LombiqHostingMediaThemePath>
    <LombiqHostingMediaThemeTargetsProps>../../../../../Lombiq.Hosting.MediaTheme/Lombiq.Hosting.MediaTheme.Targets/Lombiq.Hosting.MediaTheme.Targets.props</LombiqHostingMediaThemeTargetsProps>
    <LombiqHostingMediaThemeTargetsTargets>../../../../../Lombiq.Hosting.MediaTheme/Lombiq.Hosting.MediaTheme.Targets/Lombiq.Hosting.MediaTheme.Targets.targets</LombiqHostingMediaThemeTargetsTargets>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Condition="Exists($(LombiqHelpfulExtensionsPath))" Include="$(LombiqHelpfulExtensionsPath)" />
    <ProjectReference Condition="Exists($(LombiqNodeJsExtensionsPath))" Include="$(LombiqNodeJsExtensionsPath)" />
    <ProjectReference Condition="Exists($(LombiqHostingMediaThemePath))" Include="$(LombiqHostingMediaThemePath)" />
    <PackageReference Condition="!Exists($(LombiqHelpfulExtensionsPath))" Include="Lombiq.HelpfulExtensions" Version="11.1.1-alpha.4.osoe-925" />
    <PackageReference Condition="!Exists($(LombiqNodeJsExtensionsPath))" Include="Lombiq.NodeJs.Extensions" Version="3.0.1-alpha.0.osoe-925" />
    <PackageReference Condition="!Exists($(LombiqHostingMediaThemePath))" Include="Lombiq.Hosting.MediaTheme" Version="8.0.1-alpha.9.osoe-925" />
    <PackageReference Condition="!Exists($(LombiqHostingMediaThemeTargetsProps))" Include="Lombiq.Hosting.MediaTheme.Targets" Version="8.0.1-alpha.9.osoe-925" />
  </ItemGroup>

  <ItemGroup>
    <Content Include=".config\dotnet-tools.json" />
  </ItemGroup>

  <Import Condition="Exists($(LombiqNodeJsExtensionsPath))" Project="../../../../../../Utilities/Lombiq.NodeJs.Extensions/Lombiq.NodeJs.Extensions/Lombiq.NodeJs.Extensions.props" />
  <Import Condition="Exists($(LombiqNodeJsExtensionsPath))" Project="../../../../../../Utilities/Lombiq.NodeJs.Extensions/Lombiq.NodeJs.Extensions/Lombiq.NodeJs.Extensions.targets" />
  <Import Condition="Exists($(LombiqHostingMediaThemeTargetsProps))" Project="../../../../../Lombiq.Hosting.MediaTheme/Lombiq.Hosting.MediaTheme.Targets/Lombiq.Hosting.MediaTheme.Targets.props" />
  <Import Condition="Exists($(LombiqHostingMediaThemeTargetsTargets))" Project="../../../../../Lombiq.Hosting.MediaTheme/Lombiq.Hosting.MediaTheme.Targets/Lombiq.Hosting.MediaTheme.Targets.targets" />

  <!-- Overriding to change the dependency order of the targets. -->
  <Target Name="MediaThemeDeploymentBeforeTargets" BeforeTargets="EmbeddModuleAssets;OrchardCoreEmbedModuleAssets" />
  <Target Name="MediaThemeDeploymentAfterTargets" AfterTargets="NpmDotnetPrebuild" />

  <PropertyGroup>
    <!-- This must be defined after the Lombiq.Hosting.MediaTheme.Targets import to override property. -->
    <MediaThemeRecipeFileName>GPUDay.MediaTheme</MediaThemeRecipeFileName>
  </PropertyGroup>

  <!-- Fixes "NU1901: Package has a known low severity vulnerability" errors. -->
  <ItemGroup>
    <PackageReference Include="MimeKit" Version="4.16.0" NoWarn="NU1510" />
  </ItemGroup>
</Project>
